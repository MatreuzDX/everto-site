# ─────────────────────────────────────────────────────────────
# CAETANO IMPORTZ — variáveis de ambiente
# Copiar para `.env` e preencher. O `.env` NUNCA vai para o Git.
# Nunca pôr aqui valores inventados: o que não existe fica vazio.
# ─────────────────────────────────────────────────────────────

# BASE DE DADOS
# Produção: Vercel → projeto → Storage → Neon. A Vercel define sozinha
# DATABASE_URL e DATABASE_URL_UNPOOLED.
# Local: `npm run db:start` (Postgres embebido, porta 5434).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/caetano"

# URL pública do site (sem barra final). Usada no SEO, sitemap e links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# CONTA DE ADMINISTRAÇÃO INICIAL (criada pelo seed se não existir)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""

# LOGIN COM GOOGLE — Google Cloud Console → APIs e serviços → Credenciais →
# Criar ID do cliente OAuth (Aplicação Web). URIs de redirecionamento:
#   https://<domínio>/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
# Vazio = botão "Continuar com Google" escondido.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# IMAGENS — Vercel → Storage → Blob. Sem isto, em desenvolvimento as
# imagens ficam em public/uploads; em produção o upload recusa.
BLOB_READ_WRITE_TOKEN=""

# PAGAMENTOS — só ficam ativos quando as credenciais reais existirem.
# ifthenpay (MB WAY, Multibanco, cartão). Pedir em ifthenpay.com (exige
# atividade aberta nas Finanças).
IFTHENPAY_MBWAY_KEY=""
IFTHENPAY_MULTIBANCO_KEY=""
IFTHENPAY_CCARD_KEY=""
IFTHENPAY_ANTI_PHISHING_KEY=""

# ANALYTICS — IDs reais apenas. Vazio = não carrega nada.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
# Código de verificação do Google Search Console (só o valor do content="")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
